#!/usr/bin/env bash
# PostToolUse: re-run checks after an edit to code, and show failures to the agent.
set -uo pipefail
root="$CLAUDE_PROJECT_DIR"
file=$(jq -r '.tool_input.file_path // empty')
case "$file" in
  "$root"/mods/*|"$root"/tests/*|"$root"/scripts/*) ;;
  *) exit 0 ;;
esac

if ! out=$("$root/scripts/check" 2>&1); then
  printf 'Checks failed after editing %s:\n%s\n' "${file#"$root"/}" "$out" >&2
  exit 2
fi
