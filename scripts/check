#!/usr/bin/env bash
# Lint and test everything. Git and Claude Code hooks both call this.
set -euo pipefail
cd "$(dirname "$0")/.."

for mod in mods/*/; do
  [ -e "$mod" ] || continue
  echo "check: ${mod%/}"
  # Also writes the mod's gpui-kit.d.ts (and jsconfig.json if absent), which tsc needs.
  herdr-app check "$mod"
  node_modules/.bin/tsc -p "${mod}jsconfig.json"
done

# A git hook inherits these (`commit -a` sets GIT_INDEX_FILE); the tests' git calls would hit this repo.
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE
node --test
